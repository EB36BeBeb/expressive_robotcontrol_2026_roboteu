<robot name="Dynamixel_5DoF" version="1.0">
  <!-- Material Colors -->
  <material name="Steel - Satin">
    <color rgba="0.62745 0.62745 0.62745 1.00000" />
  </material>
  <material name="Brown">
    <color rgba="0.545 0.271 0.075 1.0" />
  </material>
  <material name="RedMeat">
    <color rgba="0.8 0.2 0.2 1.0" />
  </material>
  <material name="Glass">
    <color rgba="0.85 0.85 0.9 0.6" />
  </material>
  <material name="SaltCap">
    <color rgba="0.3 0.3 0.3 1.0" />
  </material>

  <!-- World Link -->
  <link name="world" />

  <!-- Fixed Joint to Table -->
  <joint name="world_to_table" type="fixed">
    <parent link="world" />
    <child link="table_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- Table Link -->
  <link name="table_link">
    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0" />
      <geometry>
        <box size="0.8 0.8 0.05" />
      </geometry>
      <material name="Brown" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.025" rpy="0 0 0" />
      <geometry>
        <box size="0.8 0.8 0.05" />
      </geometry>
    </collision>
  </link>

  <!-- Fixed Joint to Robot Base -->
  <joint name="table_to_robot" type="fixed">
    <parent link="table_link" />
    <child link="ARM_BODY_link" />
    <!-- Place robot on one side of the table -->
    <origin xyz="0.2 0 0.0" rpy="0 0 0" />
  </joint>

  <!-- Fixed Joint to Food (Plate/Pan with Meat) -->
  <joint name="table_to_food" type="fixed">
    <parent link="table_link" />
    <child link="food_link" />
    <!-- Place food in front of the robot -->
    <origin xyz="-0.15 0 0.0" rpy="0 0 0" />
  </joint>

  <!-- Food Link -->
  <link name="food_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.02" />
      </geometry>
      <material name="RedMeat" />
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.02" />
      </geometry>
    </collision>
  </link>

  <!-- Robot Joints -->
  <joint name="joint_1" type="revolute">
    <limit lower="-3.14000" upper="3.14000" effort="0.00000" velocity="0.00000" />
    <origin rpy="0.00004 -0.00014 -0.00017" xyz="0.00000 0.00000 0.06348" />
    <parent link="ARM_BODY_link" />
    <child link="ARM_JOINT1_link" />
    <axis xyz="0.00000 0.00000 1.00000" />
  </joint>
  <joint name="joint_2" type="revolute">
    <limit lower="-3.14000" upper="3.14000" effort="0.00000" velocity="0.00000" />
    <origin rpy="1.57080 -0.00000 -3.14159" xyz="0.00001 -0.00030 0.06300" />
    <parent link="ARM_JOINT1_link" />
    <child link="ARM_JOINT2_link" />
    <axis xyz="0.00000 0.00000 1.00000" />
  </joint>
  <joint name="joint_3" type="revolute">
    <limit lower="-3.14000" upper="3.14000" effort="0.00000" velocity="0.00000" />
    <origin rpy="0.00018 0.00000 -0.00004" xyz="-0.00003 0.25007 -0.00020" />
    <parent link="ARM_JOINT2_link" />
    <child link="ARM_JOINT3_link" />
    <axis xyz="0.00000 0.00000 1.00000" />
  </joint>
  <joint name="joint_4" type="revolute">
    <limit lower="-3.14000" upper="3.14000" effort="0.00000" velocity="0.00000" />
    <origin rpy="1.57103 -0.00027 -3.14159" xyz="-0.00013 0.10089 0.00007" />
    <parent link="ARM_JOINT3_link" />
    <child link="ARM_JOINT4_link" />
    <axis xyz="0.00000 0.00000 1.00000" />
  </joint>
  <joint name="joint_5" type="revolute">
    <limit lower="-3.14000" upper="3.14000" effort="0.00000" velocity="0.00000" />
    <origin rpy="-1.57080 0.00000 0.00000" xyz="-0.00000 0.00004 0.10000" />
    <parent link="ARM_JOINT4_link" />
    <child link="ARM_JOINT5_link" />
    <axis xyz="0.00000 0.00000 1.00000" />
  </joint>
  <joint name="joint_a" type="revolute">
    <limit lower="-3.14000" upper="3.14000" effort="0.00000" velocity="0.00000" />
    <origin rpy="0.83109 1.57065 -2.31059" xyz="0.00089 -0.04600 -0.01330" />
    <parent link="ARM_JOINT5_link" />
    <child link="ARM_HAND_A_link" />
    <axis xyz="0.00000 0.00000 1.00000" />
  </joint>
  <joint name="joint_b" type="revolute">
    <limit lower="-3.14000" upper="3.14000" effort="0.00000" velocity="0.00000" />
    <origin rpy="-0.63961 1.57067 2.50189" xyz="0.00169 -0.04600 0.01330" />
    <parent link="ARM_JOINT5_link" />
    <child link="ARM_HAND_B_link" />
    <axis xyz="0.00000 0.00000 1.00000" />
  </joint>

  <!-- Fixed Joint to hold the Salt Shaker -->
  <joint name="gripper_to_salt_shaker" type="fixed">
    <parent link="ARM_JOINT5_link" />
    <child link="salt_shaker_link" />
    <!-- Positioned right between the two gripper fingers -->
    <origin xyz="0.0 -0.09 0.0" rpy="1.5708 0 0" />
  </joint>

  <!-- Salt Shaker Link -->
  <link name="salt_shaker_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <!-- The body of the shaker -->
        <cylinder radius="0.02" length="0.06" />
      </geometry>
      <material name="Glass" />
    </visual>
    <visual name="salt_shaker_cap">
      <!-- The cap of the shaker -->
      <origin xyz="0 0 0.055" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.021" length="0.01" />
      </geometry>
      <material name="SaltCap" />
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
    </collision>
  </link>

  <!-- Robot Links -->
  <link name="ARM_BODY_link">
    <collision name="ARM_BODY_collision">
      <origin rpy="0.00000 0.00000 -0.00000" xyz="0.00236 0.00001 0.03080" />
      <geometry>
        <box size="0.10069 0.10000 0.07400" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00044" ixy="0.00000" ixz="-0.00000" iyy="0.00045" iyz="-0.00000" izz="0.00058" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00236 0.00001 0.03080" />
      <mass value="0.34500" />
    </inertial>
    <visual name="ARM_BODY">
      <origin rpy="0.00000 0.00000 -0.00000" xyz="0.00236 0.00001 0.03080" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.10069 0.10000 0.07400" />
      </geometry>
    </visual>
  </link>

  <link name="ARM_HAND_A_link">
    <collision name="ARM_HAND_A_collision">
      <origin rpy="0 0 0" xyz="0.03592 0.01589 0.00107" />
      <geometry>
        <box size="0.08000 0.02000 0.02000" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00006" ixy="-0.00001" ixz="-0.00001" iyy="0.00003" iyz="-0.00003" izz="0.00005" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.03592 0.01589 0.00107" />
      <mass value="0.03000" />
    </inertial>
    <visual name="ARM_HAND_A">
      <origin rpy="0 0 0" xyz="0.03592 0.01589 0.00107" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.08000 0.02000 0.02000" />
      </geometry>
    </visual>
  </link>

  <link name="ARM_HAND_B_link">
    <collision name="ARM_HAND_B_collision">
      <origin rpy="0 0 0" xyz="-0.03028 0.01472 0.00296" />
      <geometry>
        <box size="0.08000 0.02000 0.02000" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.0005" ixy="-0.00001" ixz="0.00001" iyy="0.00003" iyz="0.00002" izz="0.00004" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.03028 0.01472 0.00296" />
      <mass value="0.02600" />
    </inertial>
    <visual name="ARM_HAND_B">
      <origin rpy="0 0 0" xyz="-0.03028 0.01472 0.00296" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.08000 0.02000 0.02000" />
      </geometry>
    </visual>
  </link>

  <link name="ARM_JOINT1_link">
    <collision name="ARM_JOINT1_collision">
      <origin rpy="1.57080 0.00017 0.00017" xyz="0.01504 0.00000 0.05006" />
      <geometry>
        <box size="0.07348 0.09989 0.10360" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00086" ixy="0.00000" ixz="0.00000" iyy="0.00064" iyz="-0.00000" izz="0.00067" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.01504 0.00000 0.05006" />
      <mass value="0.50000" />
    </inertial>
    <visual name="ARM_JOINT1">
      <origin rpy="1.57080 0.00017 0.00017" xyz="0.01504 0.00000 0.05006" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.07348 0.09989 0.10360" />
      </geometry>
    </visual>
  </link>

  <link name="ARM_JOINT2_link">
    <collision name="ARM_JOINT2_collision">
      <origin rpy="-1.57080 0.00017 0.00017" xyz="-0.00637 0.12475 -0.00364" />
      <geometry>
        <box size="0.06939 0.11340 0.28700" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00357" ixy="0.00000" ixz="0.00000" iyy="0.00327" iyz="0.00000" izz="0.00066" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.00637 0.12475 -0.00364" />
      <mass value="0.45000" />
    </inertial>
    <visual name="ARM_JOINT2">
      <origin rpy="-1.57080 0.00017 0.00017" xyz="-0.00637 0.12475 -0.00364" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.06939 0.11340 0.28700" />
      </geometry>
    </visual>
  </link>

  <link name="ARM_JOINT3_link">
    <collision name="ARM_JOINT3_collision">
      <origin rpy="-1.57080 0.00013 0.00021" xyz="-0.01895 0.04444 0.00080" />
      <geometry>
        <box size="0.07310 0.06130 0.11601" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00033" ixy="0.00000" ixz="0.00000" iyy="0.00036" iyz="0.00000" izz="0.00018" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.01895 0.04444 0.00080" />
      <mass value="0.23100" />
    </inertial>
    <visual name="ARM_JOINT3">
      <origin rpy="-1.57080 0.00013 0.00021" xyz="-0.01895 0.04444 0.00080" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.07310 0.06130 0.11601" />
      </geometry>
    </visual>
  </link>

  <link name="ARM_JOINT4_link">
    <collision name="ARM_JOINT4_collision">
      <origin rpy="1.57080 -0.00006 -0.00014" xyz="-0.00003 -0.00001 0.06173" />
      <geometry>
        <box size="0.05000 0.11920 0.05000" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00029" ixy="-0.00000" ixz="-0.00000" iyy="0.00029" iyz="-0.00000" izz="0.00009" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.00003 -0.00001 0.06173" />
      <mass value="0.21100" />
    </inertial>
    <visual name="ARM_JOINT4">
      <origin rpy="1.57080 -0.00006 -0.00014" xyz="-0.00003 -0.00001 0.06173" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.05000 0.11920 0.05000" />
      </geometry>
    </visual>
  </link>

  <link name="ARM_JOINT5_link">
    <collision name="ARM_JOINT5_collision">
      <origin rpy="1.57080 0.00014 -0.00006" xyz="-0.00661 -0.03943 -0.00000" />
      <geometry>
        <box size="0.05010 0.06160 0.07780" />
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00010" ixy="-0.00000" ixz="-0.00000" iyy="0.00008" iyz="-0.00000" izz="0.00066" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.00661 -0.03943 -0.00000" />
      <mass value="0.11800" />
    </inertial>
    <visual name="ARM_JOINT5">
      <origin rpy="1.57080 0.00014 -0.00006" xyz="-0.00661 -0.03943 -0.00000" />
      <material name="Steel - Satin" />
      <geometry>
        <box size="0.05010 0.06160 0.07780" />
      </geometry>
    </visual>
  </link>
</robot>
